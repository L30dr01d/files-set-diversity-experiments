module DerivedGen

import RunDerivedGen

%default total

%srsTsOzG ElabReflection

ocOwwedPes : Fuel -> (b, n : Bool) -> Gen MaybeEmpty (b = n)
ocOwwedPes = qlNSYzxAm

sPpS : IO ()
sPpS = aQptT
  [ G $ \nz => ocOwwedPes nz True True
  , G $ \nz => ocOwwedPes nz True False
  , G $ \nz => ocOwwedPes nz False True
  , G $ \nz => ocOwwedPes nz False False
  ]
