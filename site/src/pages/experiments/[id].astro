---
import Layout from '../../layouts/Layout.astro';
import DownloadIcon from '../../components/DownloadIcon.astro';
import { loadExperiments } from '../../data/experiments';
import type { Experiment } from '../../data/experiments';

export function getStaticPaths() {
  return loadExperiments().map(experiment => ({
    params: { id: experiment.id },
    props: { experiment },
  }));
}

interface Props { experiment: Experiment }
const { experiment: { id, title, hasSvg, hasPng, disable_reason } } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={title} viewer>
  <header>
    <a class="back-link" href={base}>← Experiments</a>
    <h1>{title}</h1>
    <nav aria-label="Download plot">
      {!disable_reason && hasPng
        ? <a href={`${base}plots/${id}.png`} download={`${id}.png`} role="button" class="secondary outline" aria-label="Download PNG"><DownloadIcon /> PNG</a>
        : <button class="secondary outline" disabled title={disable_reason ?? "PNG file was not found"} aria-label="Download PNG"><DownloadIcon /> PNG</button>}
      {!disable_reason && hasSvg
        ? <a href={`${base}plots/${id}.svg`} download={`${id}.svg`} role="button" aria-label="Download SVG"><DownloadIcon /> SVG</a>
        : <button disabled title={disable_reason ?? "SVG file was not found"} aria-label="Download SVG"><DownloadIcon /> SVG</button>}
    </nav>
  </header>
  <figure class:list={['plot', !disable_reason && hasSvg && 'zoomable-plot']}>
    {disable_reason
      ? <p>{disable_reason}</p>
      : hasSvg
      ? <>
          <div class="plot-scroll" role="region" aria-label="Plot image" tabindex="0">
            <img src={`${base}plots/${id}.svg`} alt={`Plot: ${title}`} draggable="false" />
          </div>
          <div class="zoom-controls" role="group" aria-label="Plot zoom">
            <output aria-label="Zoom level">100%</output>
            <button type="button" class="secondary outline" data-fit aria-label="Fit image" aria-disabled="true">Fit</button>
            <input type="range" data-zoom min="50" max="500" value="100" aria-label="Zoom level" aria-orientation="vertical" aria-valuetext="100%" />
          </div>
        </>
      : <p>Plot .svg was not found.</p>}
  </figure>
</Layout>

<style>
  .zoomable-plot {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr);
    place-items: stretch;
    gap: .5rem;
  }
  .zoom-controls {
    display: flex;
    box-shadow: none;
    align-items: center;
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    flex-direction: column;
    gap: .25rem;
  }
  .zoom-controls button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--pico-border-radius);
    margin: 0;
    padding: 0;
    font-size: .85rem;
  }
  .zoom-controls button[aria-disabled="true"] { opacity: .5; cursor: default; }
  .zoom-controls input[type="range"] {
    appearance: auto;
    writing-mode: vertical-lr;
    direction: rtl;
    width: 40px;
    height: clamp(5rem, 25dvh, 10rem);
    margin: 0;
    accent-color: var(--pico-primary);
  }
  .zoom-controls input[type="range"]::-webkit-slider-runnable-track { all: revert; }
  .zoom-controls input[type="range"]::-webkit-slider-thumb { all: revert; }
  .zoom-controls input[type="range"]::-moz-range-track { all: revert; }
  .zoom-controls input[type="range"]::-moz-range-thumb { all: revert; }
  .zoom-controls :is(button, input[type="range"]):focus-visible {
    outline: 2px solid var(--pico-primary);
  }
  .zoom-controls output {
    width: 40px;
    color: var(--pico-muted-color);
    font-size: .85rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .plot-scroll {
    grid-column: 1;
    grid-row: 1;
    container-type: size;
    overflow: auto;
  }
  .plot-scroll:focus-visible { outline: 2px solid var(--pico-primary); }
  .plot-scroll img {
    display: block;
    width: calc(100cqw * var(--plot-zoom, 1));
    max-width: none;
    height: calc(100cqh * var(--plot-zoom, 1));
    object-fit: contain;
  }
  .zoomable-plot[data-zoomed] .plot-scroll img { cursor: grab; user-select: none; }
  .zoomable-plot[data-zoomed] .plot-scroll[data-dragging] { cursor: grabbing; }
</style>

<script>
  const plot = document.querySelector<HTMLElement>('.zoomable-plot');
  const viewport = plot?.querySelector<HTMLElement>('.plot-scroll');
  const image = viewport?.querySelector('img');
  const zoomSlider = plot?.querySelector<HTMLInputElement>('[data-zoom]');
  const fit = plot?.querySelector<HTMLButtonElement>('[data-fit]');
  const zoomLevel = plot?.querySelector('output');

  if (plot && viewport && image && zoomSlider && fit && zoomLevel) {
    let zoomPercent = Number(zoomSlider.defaultValue);

    const changeZoom = (percent: number) => {
      if (percent === zoomPercent) return;
      const zoom = percent / 100;

      // Keep the point at the center of the viewport in view as the plot scales.
      const x = image.clientWidth > viewport.clientWidth
        ? (viewport.scrollLeft + viewport.clientWidth / 2) / image.clientWidth
        : .5;
      const y = image.clientHeight > viewport.clientHeight
        ? (viewport.scrollTop + viewport.clientHeight / 2) / image.clientHeight
        : .5;
      zoomPercent = percent;
      plot.style.setProperty('--plot-zoom', String(zoom));
      plot.toggleAttribute('data-zoomed', zoom > 1);
      viewport.scrollTo(
        x * image.clientWidth - viewport.clientWidth / 2,
        y * image.clientHeight - viewport.clientHeight / 2,
      );
      zoomLevel.value = `${percent}%`;
      zoomSlider.setAttribute('aria-valuetext', zoomLevel.value);
      fit.setAttribute('aria-disabled', String(zoom === 1));
    };

    zoomSlider.addEventListener('input', () => changeZoom(zoomSlider.valueAsNumber));
    fit.addEventListener('click', () => {
      zoomSlider.value = zoomSlider.defaultValue;
      changeZoom(zoomSlider.valueAsNumber);
    });
    changeZoom(zoomSlider.valueAsNumber);

    let drag: { id: number; x: number; y: number } | undefined;
    image.addEventListener('pointerdown', event => {
      if (zoomPercent <= 100 || event.pointerType !== 'mouse' || event.button !== 0) return;
      drag = {
        id: event.pointerId,
        x: event.clientX + viewport.scrollLeft,
        y: event.clientY + viewport.scrollTop,
      };
      viewport.setPointerCapture(event.pointerId);
      viewport.setAttribute('data-dragging', '');
    });
    viewport.addEventListener('pointermove', event => {
      if (drag?.id !== event.pointerId) return;
      viewport.scrollTo(drag.x - event.clientX, drag.y - event.clientY);
    });
    viewport.addEventListener('lostpointercapture', () => {
      drag = undefined;
      viewport.removeAttribute('data-dragging');
    });
  }
</script>
