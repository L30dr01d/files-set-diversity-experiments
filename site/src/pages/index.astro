---
import Layout from '../layouts/Layout.astro';
import { loadExperiments } from '../data/experiments';

const experiments = loadExperiments();
const base = import.meta.env.BASE_URL;
---

<Layout title="Text Set Diversity Experiments">
  <header class="gallery-header">
    <div class="gallery-heading">
      <img src={`${base}assets/panhard-icon.svg`} alt="" width="600" height="400" />
      <h1>Text Set Diversity Experiments</h1>
    </div>
    <p>Latest results of {experiments.length} {experiments.length === 1 ? 'experiment' : 'experiments'}. Select a plot to view it and download the original files.</p>
  </header>
  <section class="experiment-grid" aria-label="Experiment plots">
    {experiments.map(({ id, title, hasHtml, hasSvg, disable_reason }) => (
      <a class="experiment-card" href={`${base}experiments/${id}/`}>
        <article>
          {disable_reason
            ? <p class="preview-placeholder">{disable_reason}</p>
            : hasSvg
            ? <img src={`${base}plots/${id}.svg`} alt={`Plot: ${title}`} loading="lazy" />
            : hasHtml
            ? <p class="preview-placeholder">Interactive figure</p>
            : <p class="preview-placeholder">SVG preview unavailable</p>}
          <h2>{title}</h2>
        </article>
      </a>
    ))}
  </section>
  {experiments.length === 0 && <p>No experiments configured.</p>}
</Layout>
